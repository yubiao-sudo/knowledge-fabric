# ============================================================
# Knowledge Fabric · 本机私有配置（请复制为 .env.local 后填写）
#
#   copy .env.example .env.local
#
# .env.local 已在 .gitignore 中，**不会被提交**。
# 加载优先级（先写入者生效，且环境变量优先于文件）：
#   --env-file 指定  >  <项目根>/.env.local  >  .env  >  examples/.env.local
#
# 格式：KEY=VALUE，每行一条；只有**行首** # 是注释
#       （行内 # 会保留，因为密钥里可能含 #）。
# 查看最终生效配置：
#   python examples\grounding_agent.py --show-config
# 自检生成端点（推荐先跑这个）：
#   python examples\grounding_agent.py --check-llm
# ============================================================

# ---------------- 云端 LLM（可选）----------------
# 不配置也能用 Agent，只是输出退化为 evidence_summary（只给证据，不生成答案）。
# 端点要写到 /v1 那一层，代码自行拼 /chat/completions。
#
# 变量名兼容两套习惯（任选其一，不要同时写两套）：
#   端点：OPENAI_BASE_URL 或 VLLM_URL
#   模型：OPENAI_MODEL    或 VLLM_MODEL（缺省 Qwen/Qwen2.5-1.5B-Instruct）
#   密钥：OPENAI_API_KEY  或 VLLM_API_KEY
#
# DeepSeek（示例，取消注释并填入真实密钥）：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# OPENAI_API_KEY=sk-你的密钥
#
# 阿里云百炼（通义）：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
# OPENAI_API_KEY=sk-你的密钥
#
# 本地 Ollama：
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b
# OPENAI_API_KEY=ollama
#
# 本地 vLLM：
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 生成调用超时（秒）
KF_LLM_TIMEOUT=120


# ---------------- Agent 行为 ----------------
# 引用校验要从 Postgres 读块的权威内容，用来独立核对 char_range 是否真的对应 content。
# 不配则校验退化为"自洽性检查"（只验证偏移归属，不比对内容）。
DATABASE_URL=postgresql://kf:kf_dev_password@localhost:15432/knowledge_fabric

# MCP 端点（经网关，会走 Laya 决策；Laya 在 CPU 上较慢，见 README 已知缺口第 2 条）
KF_GATEWAY_MCP=http://127.0.0.1:8000/mcp

# Agent 自设的证据分门槛：低于此值直接拒答（0 = 用底座自己的判定）
#   ⚠️ 注意：hybrid_rerank 等档位的分数是 RRF 融合分，上界仅 1/(k+1)≈0.0164，
#   设成 0.5 会把所有查询都拒掉。要用它请配合 assembly.answerability=cosine。
KF_AGENT_MIN_SCORE=0


# ---------------- 答案可达阈值（拒答判定）----------------
# 底座的拒答阈值**按库标定**，结果在 configs/answerability_calibration.json。
# 语料变化后重跑（会打印每个库的噪声底与阈值）：
#   python scripts\calibrate_answerability.py
# 只看不写：
#   python scripts\calibrate_answerability.py --dry-run
# 未标定的库回退到 configs/retrieval_profiles.yaml 的 assembly.answerability_floor。


# ---------------- 嵌入设备（多服务共卡时用）----------------
# 本机 4GB 显存装不下两份 bge-m3（摄入 + 检索各一份），故默认会自动仲裁：
# 先启动的服务占 GPU，后启动的回落 CPU 并把原因写进 /health 的 embed.device_reason。
# 如需强制：cpu / cuda / cuda:0
# KF_EMBED_DEVICE=cpu

# 嵌入序列上限与批大小。bge-m3 官方面向 8192，但位置编码与注意力缓冲按上限预留，
# 4GB 卡上容易撑爆（实测 3901/4096 MiB 后换页、吞吐塌到 0.6 块/秒）。
# 切片本身只有 200~400 token，512 足够。
KF_EMBED_MAX_LEN=512
KF_EMBED_BATCH=8

# 服务启动预热（1=开，0=关）。关闭后第一次摄入/检索要自己承担模型加载开销。
KF_WARMUP=1
