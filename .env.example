# ===== 复制为 .env 后按需修改 =====

# --- Postgres ---
POSTGRES_USER=kf
POSTGRES_PASSWORD=kf_dev_password
POSTGRES_DB=knowledge_fabric
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kf:kf_dev_password@localhost:5432/knowledge_fabric

# --- Qdrant（dense + sparse） ---
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- MinIO（原始文档 / 解析中间产物） ---
MINIO_ENDPOINT=localhost:9000
MINIO_USER=kf_minio
MINIO_PASSWORD=kf_minio_password
MINIO_BUCKET=kf-raw
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- 嵌入 / 重排（TEI） ---
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
TEI_EMBED_URL=http://localhost:8080
TEI_EMBED_PORT=8080
RERANK_MODEL=BAAI/bge-reranker-v2-m3
TEI_RERANK_URL=http://localhost:8081
TEI_RERANK_PORT=8081
# GPU 时改为：ghcr.io/huggingface/text-embeddings-inference:1.6.1
TEI_EMBED_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.6.1
TEI_RERANK_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.6.1

# --- 决策模型 Laya（本地全量部署） ---
# Laya 是 System-1 判定引擎（不是文本分类模型）。官方仓库在一个 snapshot 内
# 捆绑多个 checkpoint，用 subfolder 选择（对应 configs/model_registry.yaml 两条）：
#   typed-decisions 421M 英文 policy_routing 主模型  → decision-laya
#   multilingual    322M 100+ 语言                   → decision-laya-multilingual
# 英文查询走前者，其余语言走后者（英文版在非英文上会显著退化）。
LAYA_MODEL_ID=convaiinnovations/laya
LAYA_MODEL_MULTILINGUAL_ID=convaiinnovations/laya-multilingual
LAYA_SUBFOLDER=typed-decisions
LAYA_SUBFOLDER_MULTILINGUAL=multilingual
LAYA_DEVICE=cpu
# 权重来源：LAYA_MODEL_PATH 优先（本地目录，完全离线）；留空则从 LAYA_CACHE_DIR
# 内的 HF 缓存解析。已下载过 Laya 的机器可直接把 LAYA_CACHE_DIR 指到那个缓存根
# （目录下须有 hub/ 子目录），即可复用它人的权重、不再联网。
LAYA_MODEL_PATH=
LAYA_CACHE_DIR=./models
# 决策超时：设计硬限 300ms（假设 ~33ms 推理）；实测 CPU 单条推理约 2.5s，CPU 环境
# 保持 300ms 会令网关按超时回退 heuristic（服务端 mode=laya 却不生效）。GPU 环境
# 可调回 300；上调会占用端到端 3000ms 总预算，需一并权衡。
DECISION_TIMEOUT_MS=300
DECISION_URL=http://localhost:8090
DECISION_PORT=8090

# --- 检索服务（Python + FastAPI，services/retrieve） ---
# RETRIEVAL_URL 供网关调用；RETRIEVAL_PORT 为容器内监听端口；
# RETRIEVAL_HOST_PORT 为宿主机映射端口（避开 TEI 已占用的 8080）。
RETRIEVAL_URL=http://localhost:8082
RETRIEVAL_PORT=8080
RETRIEVAL_HOST_PORT=8082
# 生成端点（HyDE / 多查询扩展 / 查询分解用；留空则跳过增强，绝不报错）
VLLM_URL=
# 无 Docker 验证：指向一份 chunk 列表 json，启动时灌入 MemoryBackend（生产用 Qdrant 可留空）
KF_RETRIEVE_SEED_JSON=

# --- 摄入 HTTP 服务（Python + FastAPI，services/ingest）---
# 上传即摄入，供 Web 控制台（console/index.html）与 agent 接入；
# INGEST_PORT 为容器内监听端口，INGEST_HOST_PORT 为宿主机映射端口。
INGEST_PORT=8083
INGEST_HOST_PORT=8083

# --- GraphRAG 图检索 / 租户 RLS 落地 ---
# 图存储在 Postgres（实体/边/社区摘要），项目由 db/002_graph_acl_structured.sql 建好，
# 并建了**非属主角色 kf_app**：检索侧刻意用该角色连接，RLS 才真实生效
# （Postgres 的表属主可绕过 RLS，属主 kf 留给摄入与运维）。
KF_APP_PASSWORD=kf_app_password
# 是否允许摄入建图：默认关闭（按知识库 opt-in，用 CLI/HTTP 的 --graph 为单个库开启）
GRAPH_DEFAULT_ENABLED=false
# Agentic 多轮迭代硬上限（设计上限 3，此处可再收紧）
AGENTIC_MAX_ROUNDS=3

# --- 可选：分语言 BM25 稀疏索引 ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_PORT=9200
# 容器内部地址；留空 = 关闭 OpenSearch，回退 Qdrant 稀疏 + payload lang 过滤。
# 启用：docker compose --profile lang-sparse up -d opensearch，并把下面这行填上
OPENSEARCH_INTERNAL_URL=

# --- 网关 ---
GATEWAY_PORT=8000
DEFAULT_TENANT=default
